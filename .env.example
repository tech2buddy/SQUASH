# Browser-safe Supabase config used by the Vite client.
# Copy values from Supabase Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Must be exactly "true" to enable paid job posting on the client. Any other value (including unset) disables it.
VITE_PAYMENTS_ENABLED=true

# Server-only Vercel variables. Never prefix these secrets with VITE_ and never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=support@your-verified-domain.example
YOCO_SECRET_KEY=your-yoco-secret-key
YOCO_WEBHOOK_SECRET=your-yoco-webhook-signing-secret
APP_URL=https://your-production-domain.example

# Malware scanning for uploads (api/scan-upload.ts). If unset, banking-document uploads
# are rejected outright (fail closed); other uploads are allowed but flagged in file_scans.
CLOUDMERSIVE_API_KEY=your-cloudmersive-api-key
